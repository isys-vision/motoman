/JOB
//NAME INIT_ROS
//POS
///NPOS 0,0,0,0,0,0
//INST
///DATE 2013/03/29 05:32
///ATTR SC,RW
///GROUP1 RB1
NOP
' this job requires a MotoROS
' version ending in _noStartJob
'
' assume control, unless:
IF ( OT#(1569)=ON ) THEN
 RET
ENDIF
' reset MotoROS signals
DOUT OT#(890) OFF
DOUT OT#(889) OFF
' wait for MotoROS to notice
TIMER T=0.05
' set ROS_READY
' allows control by MotoROS
DOUT OT#(889) ON
WAIT OT#(890)=ON
' reset ROS_DONE
DOUT OT#(890) OFF
' Mikado gave up robot control
'
' return to caller
RET
END
