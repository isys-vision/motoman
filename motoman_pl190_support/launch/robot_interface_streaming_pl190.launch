<!--
  Manipulator specific version of 'robot_interface_streaming.launch'.
  Defaults provided for pl190:
   - joints
  Usage:
    robot_interface_streaming_pl190.launch robot_ip:=<value> controller:=<yrc1000>
-->
<launch>
  <arg name="robot_ip" />

  <!-- controller: Controller name (yrc1000) -->
  <arg name="controller" />

  <rosparam command="load" file="$(find motoman_pl190_support)/config/joint_names_pl190.yaml" />

  <include file="$(find motoman_driver)/launch/robot_interface_streaming_$(arg controller).launch">
    <arg name="robot_ip" value="$(arg robot_ip)" />
  </include>
</launch>
